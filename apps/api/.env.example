# Copy to apps/api/.env for local development. Never commit the real .env.

# Neon: leave both empty to run with in-memory storage (orders vanish on restart).
# DATABASE_URL is the pooled connection string, DATABASE_URL_UNPOOLED the direct one (needed for LISTEN).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# At least 32 random characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`.
JWT_SECRET=

# Browser origins allowed to call /admin (comma-separated).
WEB_ORIGIN=http://localhost:3000

# Pochi la Biashara by default; set PAYMENT_METHOD=stk once there is a Till/Paybill.
PAYMENT_METHOD=
MPESA_PAY_TO=0796 929 502
MPESA_PAY_TO_NAME=Shelma Maina

# Local development without a database only: seeds this back office login on startup.
DEV_OWNER_EMAIL=owner@ndutas.local
DEV_OWNER_PASSWORD=change-me-locally
DEV_OWNER_NAME=Shelma Maina
